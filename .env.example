# Copier ce fichier en .env.local (jamais commité) et adapter.
# En production, ces valeurs viennent de Secret Manager.

# Local (docker compose up -d db)
DATABASE_URL=postgresql://portail:portail_dev@127.0.0.1:5432/portail

# Cloud SQL via socket Unix (Cloud Run), pour mémoire :
# DATABASE_URL=postgresql://USER:MOT_DE_PASSE@/portail?host=/cloudsql/PROJET:REGION:INSTANCE

PORT=3000

# --- Connexion recruteurs (Auth.js)
# Secret de signature des sessions : `npx auth secret` ou 32 octets aléatoires.
AUTH_SECRET=
# Domaine autorisé (emails @domaine). En dev, n'importe quel domaine de test.
RECRUITER_EMAIL_DOMAIN=olivesoft.test
# Faux fournisseur « Connexion de test » (ignoré en production).
AUTH_DEV_LOGIN=true
# Google Workspace (console Google Cloud > Identifiants OAuth) :
# URI de redirection : <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# URL publique utilisée dans les liens candidats (sinon déduite de la requête)
# APP_URL=https://portail.example.com
