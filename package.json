{
  "name": "portail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "tsx --env-file-if-exists=.env.local server.ts",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node26 --format=cjs --packages=external --define:process.env.NODE_ENV='\"production\"' --outfile=dist/server.cjs",
    "start": "node --env-file-if-exists=.env.local dist/server.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:build": "node scripts/copy-vendor.mjs && next build && vitest run --config vitest.build.config.mts",
    "test:sandbox:linux": "docker build --target sandbox-test -t portail-sandbox-test . && docker run --rm portail-sandbox-test"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "pyodide": "314.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sql.js": "1.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "monaco-editor": "0.57.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
